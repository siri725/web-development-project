            <td>7.89 CGPA</td>
        </tr>

        <tr>
            <td>PUC</td>
            <td>GJC Sringeri</td>
            <td>87%</td>
        </tr>

        <tr>
            <td>SSLC</td>
            <td>GHS</td>
            <td>92.8%</td>
        </tr>
    </table>
</section>

<section id="skills">
    <h2>My Skills</h2>

    <ul>
        <li>HTML</li>
        <li>CSS</li>
        <li>JavaScript</li>
        <li>Python</li>
        <li>Basic Computer Skills</li>
    </ul>
</section>

<section id="contact">
    <h2>Contact Me</h2>

    <form>
        <label>Name:</label><br>
        <input type="text" name="name"><br><br>

        <label>Email:</label><br>
        <input type="email" name="email"><br><br>

        <label>Message:</label><br>
        <textarea name="message"></textarea><br><br>

        <button type="submit">Submit</button>
    </form>
</section>

<footer>
    <p>&copy; 2026 My Portfolio</p>
</footer>

<script src="script.js"></script>

</body>
</html>
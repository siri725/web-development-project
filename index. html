        <a href="#education">Education</a>
        <a href="#skills">Skills</a>
        <a href="#contact">Contact</a>
    </nav>
</header>

<section id="about">
    <h2>About Me</h2>

    <img src="profile.jpg" alt="My Profile Photo" width="150">

    <p>
        Hello! I am a BCA student interested in web development.
        I am learning HTML, CSS and JavaScript and developing my
        technical skills.
    </p>
</section>

<section id="education">
    <h2>Education</h2>

    <table border="1">
        <tr>
            <th>Course</th>
            <th>Institution</th>
